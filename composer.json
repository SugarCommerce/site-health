{
  "name": "sugarcommerce/site-health",
  "description": "A plugin's checks and its own section on Tools > Site Health, from arrays: results with a headline and a fix, slow checks over REST, and an Info section support can copy.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/site-health",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "site-health",
    "diagnostics",
    "support",
    "status"
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\SiteHealth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\SiteHealth\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "support": {
    "issues": "https://github.com/sugarcommerce/site-health/issues",
    "source": "https://github.com/sugarcommerce/site-health"
  }
}
